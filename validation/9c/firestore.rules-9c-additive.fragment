// Additif 9C uniquement, préparé après lecture seule de la console Firebase
// le 2026-10-12 (projet fath-3d-9ec0b, base (default)). Les Rules affichées
// comportent les matches Manager et 9A, mais aucun match replenishmentDecisions.
// À insérer uniquement dans le match /databases/{database}/documents existant;
// ce fragment n'est PAS un fichier Rules complet et ne doit pas remplacer
// ni être publié comme copie intégrale des Rules de production.
match /fath3d/{userId}/replenishmentDecisions/{productId} {
  function isDecisionOwner() {
    return request.auth != null && request.auth.uid == userId;
  }

  function validDecisionDate(value) {
    return value is string && (
      value.matches('^[0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$')
      || value.matches('^[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$')
      || value.matches('^[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])$')
      || value.matches('^([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29$')
    );
  }

  function validDecision(data) {
    return data is map
      && data.keys().hasOnly(['schemaVersion', 'productId', 'decision', 'reminderDate', 'revision', 'lastMutationId'])
      && data.keys().hasAll(['schemaVersion', 'productId', 'decision', 'revision', 'lastMutationId'])
      && data.schemaVersion is int && data.schemaVersion == 1
      && data.productId is string && data.productId.size() > 0
      && data.productId.size() <= 128 && data.productId == productId
      && data.decision in ['undecided', 'reprint', 'deferred', 'stopped']
      && data.revision is int && data.revision >= 1
      && data.lastMutationId is string
      && data.lastMutationId.size() >= 16 && data.lastMutationId.size() <= 80
      && (data.decision == 'deferred'
        ? (!('reminderDate' in data) || validDecisionDate(data.reminderDate))
        : !('reminderDate' in data));
  }

  allow read: if isDecisionOwner();
  allow create: if isDecisionOwner()
    && validDecision(request.resource.data)
    && request.resource.data.revision == 1;
  allow update: if isDecisionOwner()
    && validDecision(resource.data)
    && validDecision(request.resource.data)
    && request.resource.data.productId == resource.data.productId
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.lastMutationId != resource.data.lastMutationId;
  allow delete: if false;
}

